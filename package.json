{
  "name": "impact360-mcp-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified MCP gateway for HaloPSA, N-able N-central, UniFi Site Manager, and Meraki Dashboard, deployed as a single Cloudflare Worker",
  "scripts": {
    "dev": "node scripts/cloud-only.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:unifi": "node tests/unifi.test.mjs",
    "test:worker": "node tests/worker.test.mjs",
    "check:cloud": "node scripts/check-cloud.mjs",
    "upload:preview": "node scripts/upload-preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.1",
    "jose": "^6.2.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260629.1",
    "react": "^19.0.0",
    "typescript": "^5.7.2",
    "wrangler": "4.105.0"
  }
}
