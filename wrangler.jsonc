{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "impact360-mcp-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "UNIFI_NETWORK_TOOL_PERMISSION_MODE": "confirm",
    "UNIFI_POLICY_NETWORK_CREATE": "true",
    "UNIFI_POLICY_NETWORK_UPDATE": "true",
    "UNIFI_POLICY_NETWORK_DELETE": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "UNIFI_APPROVALS",
        "class_name": "UnifiApproval"
      }
    ]
  },
  "migrations": [
    {
      "tag": "unifi-approvals-v1",
      "new_sqlite_classes": [
        "UnifiApproval"
      ]
    }
  ]
}
